{
  "appId": "dev.poehali.mine-emergency-map-editor",
  "productName": "Mine Emergency Map Editor",
  "directories": {
    "output": "dist-electron"
  },
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "nodeGypRebuild": false,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!**/node_modules/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerLanguages": ["ru_RU", "en_US"],
    "language": "1049"
  },
  "mac": {
    "target": "dmg",
    "icon": "public/favicon.ico"
  },
  "linux": {
    "target": "AppImage"
  }
}