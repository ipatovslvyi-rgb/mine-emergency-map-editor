{
  "appId": "ru.sau.app",
  "productName": "САУ",
  "directories": {
    "output": "dist-electron"
  },
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "nodeGypRebuild": false,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!**/node_modules/**/*"
  ],
  "artifactName": "САУ.exe",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/logo.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerLanguages": ["ru_RU", "en_US"],
    "language": "1049",
    "shortcutName": "САУ",
    "uninstallDisplayName": "САУ — Схема аварийного участка",
    "installerSidebar": null,
    "defaultInstallDir": "$PROGRAMFILES\\САУ"
  },
  "mac": {
    "target": "dmg",
    "icon": "public/logo.ico"
  },
  "linux": {
    "target": "AppImage"
  }
}